<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Paket adı GunTeknik.app (ASCII): "ü"lü klasör adında macOS araçları (WidgetKit) bulamıyor. Görünen ad yine "Gün Teknik". -->
	<key>CFBundleName</key>
	<string>Gün Teknik</string>
	<key>CFBundleDisplayName</key>
	<string>Gün Teknik</string>
	<!-- gunteknik://ac?yol=./?arama=bugun — masaüstü araçlarına dokununca uygulama o sayfada açılır -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gunteknik.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gunteknik</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
