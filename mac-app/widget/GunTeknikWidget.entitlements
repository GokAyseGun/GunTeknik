<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit araçları her zaman korumalı alanda (sandbox) çalışır -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- veri tazeleme ve "geri al" için Supabase'e bağlanır -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Gün Teknik uygulamasının yazdığı widget.json'u okur (~/Library/Application Support/com.gunteknik.mac/) -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/com.gunteknik.mac/</string>
	</array>
</dict>
</plist>
