<?xml version="1.0" encoding="utf-8"?>
<!-- Pano: üst yarı işletme (küçük: arama · ajanda · evrak · kasa), alt yarı sağlık (yalnız sağlık sahibinde: Atak · Nabız · Su) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_zemin"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Gün Teknik"
            android:textColor="#FFF0F0F0"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_rozet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="#FF808080"
            android:textSize="10.5sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="34dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ekle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_ekle"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="📞 Arama"
            android:textColor="#FFF0F0F0"
            android:textSize="10.5sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sayi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;Arama"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/w_geri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="↶ Geri al"
            android:textColor="#FFF0F0F0"
            android:textSize="10.5sp" />
        <TextView
            android:id="@+id/w_randevu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_randevu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="📅 Randevu"
            android:textColor="#FFF0F0F0"
            android:textSize="10.5sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="34dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_aj1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;Ajanda"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/w_aj10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;10 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/w_ev1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;Evrak"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/w_ev5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;5 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/w_ev15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="—&#10;15 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.75"
        android:minHeight="26dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_kasa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="3"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="💰 Kasa  •••"
            android:textColor="#FFF0F0F0"
            android:textSize="10.5sp" />
        <TextView
            android:id="@+id/w_goz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="👁 Göster"
            android:textColor="#FFF0F0F0"
            android:textSize="10.5sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_saglik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:minHeight="96dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_atak"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_atak"
                android:gravity="center"
                android:maxLines="1"
                android:text="⚡ Atak"
                android:textColor="#FFF0F0F0"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_nabiz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_nabiz"
                android:gravity="center"
                android:maxLines="1"
                android:text="❤️ Nabız"
                android:textColor="#FFF0F0F0"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_su"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_su"
                android:gravity="center"
                android:maxLines="1"
                android:text="💧 ＋200 ml"
                android:textColor="#FFF0F0F0"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_atak_gun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_kutu"
                android:gravity="top|start"
                android:maxLines="6"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:text="—"
                android:textColor="#FFB0B0B0"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/w_nabiz_gun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_kutu"
                android:gravity="top|start"
                android:maxLines="6"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:text="—"
                android:textColor="#FFB0B0B0"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/w_su_gun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/w_kutu"
                android:gravity="top|start"
                android:maxLines="6"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:text="—"
                android:textColor="#FFB0B0B0"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:text="↻"
        android:textColor="#FF808080"
        android:textSize="10sp" />
</LinearLayout>
