<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_zemin"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Gün Teknik"
            android:textColor="#FFF0F0F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_rozet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="#FF808080"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_kanal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/w_dugme"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="📞 Telefon"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_st1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="—\nArama"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_st2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="—\nAjanda"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_st3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="—\nÖdeme"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_st4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="•••\nKasa"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        
        android:orientation="horizontal">
        <TextView
            android:id="@+id/s0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Elektrik"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Klima"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="TV/Uydu"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="İnternet"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        
        android:orientation="horizontal">
        <TextView
            android:id="@+id/s4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Tesisat"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Metal"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Ahşap"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/s7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Diğer"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_icerik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_alt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↻"
            android:textColor="#FF808080"
            android:textSize="10.5sp" />


        <TextView
            android:id="@+id/w_geri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/w_dugme"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="↶"
            android:textColor="#FFB0B0B0"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
