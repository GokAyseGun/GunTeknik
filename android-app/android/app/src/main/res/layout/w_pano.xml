<?xml version="1.0" encoding="utf-8"?>
<!-- Pano: 4 satır × 3 sütun — arama · ajanda · evrak · kasa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_zemin"
    android:orientation="vertical"
    android:padding="9dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Gün Teknik"
            android:textColor="#FFF0F0F0"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_rozet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="#FF808080"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ekle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_ekle"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="📞&#10;Arama ekle"
            android:textColor="#FFF0F0F0"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sayi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Arama · bugün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_geri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="↶&#10;Geri al"
            android:textColor="#FFF0F0F0"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_randevu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_randevu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="📅&#10;Randevu ekle"
            android:textColor="#FFF0F0F0"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_aj1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Ajanda · bugün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_aj10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Ajanda · 10 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ev1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Evrak · bugün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_ev5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Evrak · 5 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_ev15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—&#10;Evrak · 15 gün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_kasa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="💰 Kasa  •••"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_goz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="👁&#10;Göster"
            android:textColor="#FFF0F0F0"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:text="↻"
        android:textColor="#FF808080"
        android:textSize="10.5sp" />
</LinearLayout>
