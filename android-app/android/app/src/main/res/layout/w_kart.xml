<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_zemin"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_baslik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Gün Teknik"
            android:textColor="#FFF0F0F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_rozet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:textColor="#FF00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_dugme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/w_dugme"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="👁 Göster"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_icerik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/w_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="↻"
        android:textColor="#FF707070"
        android:textSize="10sp" />
</LinearLayout>
