<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_zemin"
    android:orientation="vertical"
    android:padding="9dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ekle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/w_ekle"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="📞  Arama ekle"
            android:textColor="#FFF0F0F0"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_sayi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/w_kutu"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="—
bugün"
            android:textColor="#FFF0F0F0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_geri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="0.5"
            android:background="@drawable/w_dugme"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="↶"
            android:textColor="#FFF0F0F0"
            android:textSize="16sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:text="↻"
        android:textColor="#FF808080"
        android:textSize="10.5sp" />
</LinearLayout>
